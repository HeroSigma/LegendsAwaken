mapscripts LittlerootTown_BrendansHouse_2F_MapScripts {
}

// Rival script
script RivalsHouse_2F_EventScript_Rival {
    lockall
    msgbox(RivalsHouse_2F_Text_BrendanWhoAreYou, MSGBOX_DEFAULT)
    releaseall
    return
}

// Rival's Poké Ball script
script LittlerootTown_BrendansHouse_2F_EventScript_RivalsPokeBall {
    lockall
    msgbox(RivalsHouse_2F_Text_ItsBrendansPokeBall, MSGBOX_DEFAULT)
    releaseall
    return
}

// Z-Ring Ball script
script LittlerootTown_BrendansHouse_2F_EventScript_ZRingBall {
    lockall
    msgbox(LittlerootTown_BrendansHouse_2F_Text_ZRingBall, MSGBOX_DEFAULT)
    releaseall
    return
}

// PC script
script LittlerootTown_BrendansHouse_2F_EventScript_PC {
    lockall
    msgbox(gText_PokemonTrainerSchoolEmail, MSGBOX_DEFAULT)
    releaseall
    return
}

// Turn off PC script
script LittlerootTown_BrendansHouse_2F_EventScript_TurnOffPlayerPC {
    lockall
    setvar(VAR_0x8004, PC_LOCATION_BRENDANS_HOUSE)
    playse(SE_PC_OFF)
    special(DoPCTurnOffEffect)
    releaseall
    return
}

// Text blocks
text RivalsHouse_2F_Text_BrendanWhoAreYou {
    "BRENDAN: Who are you?\p"
    "Oh, it's you, {PLAYER}!\p"
    "What brings you here?\p"
    "$"
}

text RivalsHouse_2F_Text_ItsBrendansPokeBall {
    "This is BRENDAN's POKé BALL.\p"
    "Better not touch it!\p"
    "$"
}

text LittlerootTown_BrendansHouse_2F_Text_ZRingBall {
    "There's something sparkly here!\p"
    "It's a Z-RING!\p"
    "$"
}
