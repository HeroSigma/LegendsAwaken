// Truck scene text blocks
text gText_Truck_Intro {
    "{COLOR GREEN}(Where… where am I?\n"
    "My head hurts…)\n"
    "{COLOR DARK_GRAY}\n"
    "I'm in a moving truck…\p"
    "It's dark and cramped in here.\p"
    "$"
}

text gText_Truck_PlayerReflection {
    "{COLOR GREEN}(How did I get here?\n"
    "I don't remember…)\n"
    "{COLOR DARK_GRAY}\n"
    "The last thing I remember…\p"
    "was… what was it?\p"
    "$"
}

text gText_Truck_ReadyToExit {
    "{COLOR GREEN}(The truck stopped.\n"
    "I should get out.)\n"
    "{COLOR DARK_GRAY}\n"
    "Time to see what's outside.\p"
    "$"
}
