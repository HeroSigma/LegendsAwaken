mapscripts LittlerootTown_BrendansHouse_1F_MapScripts {
}

// Rival's Mom scripts
script RivalsHouse_1F_EventScript_RivalMom {
    msgbox(RivalsHouse_1F_Text_RivalMom, MSGBOX_DEFAULT)
    return
}

script RivalsHouse_1F_EventScript_RivalSibling {
    msgbox(RivalsHouse_1F_Text_RivalSibling, MSGBOX_DEFAULT)
    return
}

// Meet rival scripts
script LittlerootTown_BrendansHouse_1F_EventScript_GoSeeRoom {
    lockall
    msgbox(LittlerootTown_BrendansHouse_1F_Text_GoSeeRoom, MSGBOX_DEFAULT)
    releaseall
    return
}

script LittlerootTown_BrendansHouse_1F_EventScript_MeetRival0 {
    lockall
    msgbox(LittlerootTown_BrendansHouse_1F_Text_MeetRival0, MSGBOX_DEFAULT)
    releaseall
    return
}

script LittlerootTown_BrendansHouse_1F_EventScript_MeetRival1 {
    lockall
    msgbox(LittlerootTown_BrendansHouse_1F_Text_MeetRival1, MSGBOX_DEFAULT)
    releaseall
    return
}

script LittlerootTown_BrendansHouse_1F_EventScript_MeetRival2 {
    lockall
    msgbox(LittlerootTown_BrendansHouse_1F_Text_MeetRival2, MSGBOX_DEFAULT)
    releaseall
    return
}

// Text blocks
text RivalsHouse_1F_Text_RivalMom {
    "MOM: Oh, you must be {PLAYER}!\p"
    "BRENDAN has been waiting for you!\p"
    "He's upstairs in his room.\p"
    "$"
}

text RivalsHouse_1F_Text_RivalSibling {
    "SIBLING: Hi, {PLAYER}!\p"
    "BRENDAN's been looking for you.\p"
    "He's upstairs.\p"
    "$"
}

text LittlerootTown_BrendansHouse_1F_Text_GoSeeRoom {
    "MOM: Why don't you go see\n"
    "BRENDAN's room?\p"
    "$"
}

text LittlerootTown_BrendansHouse_1F_Text_MeetRival0 {
    "BRENDAN: {PLAYER}! You're here!\p"
    "I was just about to go look for you.\p"
    "$"
}

text LittlerootTown_BrendansHouse_1F_Text_MeetRival1 {
    "BRENDAN: Hey, {PLAYER}!\p"
    "Ready to start our adventure?\p"
    "$"
}

text LittlerootTown_BrendansHouse_1F_Text_MeetRival2 {
    "BRENDAN: There you are, {PLAYER}!\p"
    "I've been waiting.\p"
    "$"
}
