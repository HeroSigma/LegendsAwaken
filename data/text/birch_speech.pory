text gText_Creator_Welcome {
    "{COLOR LIGHT_RED}Greetings, traveler. I am HERO SIGMA-\n"
    "the one who shaped this world.\p"
    "This is no ordinary journey.\n"
    "Legends stir across time and space…\l"
    "awakened by the Rift that tore our\l"
    "worlds apart.\p"
    "Here, you will walk among them,\n"
    "battle them, and uncover truths\l"
    "long buried.\p"
    "But remember… your choices will echo\n"
    "across regions. Your bonds with\l"
    "POKéMON will shape the fate of all\l"
    "creation.{COLOR WHITE}\p"
}

text gText_Birch_Welcome {
    "{COLOR GREEN}Welcome to the world of POKéMON!\n"
    "I'm Professor BIRCH-field researcher.\p"
    "I study local POKéMON and I'm glad\n"
    "to finally meet you.{COLOR WHITE}\p"
}

text gText_Birch_Pokemon {
    "{COLOR GREEN}This little one is a POKéMON-\n"
    "your partner and friend.{COLOR WHITE}\p"
}

text gText_Birch_MainSpeech {
    "{COLOR GREEN}HOENN's been strange lately.\p"
    "Currents shift, skies shimmer…\n"
    "people whisper about 'rifts'.\p"
    "We observe, we protect, and when\n"
    "we must, we battle together.\p"
    "But first…{COLOR WHITE}\p"
}

text gText_Birch_AndYouAre {
    "{COLOR GREEN}And you are?{COLOR WHITE}$"
}

text gText_Birch_BoyOrGirl {
    "{COLOR GREEN}Are you a boy, or a girl?{COLOR WHITE}$"
}

text gText_Birch_WhatsYourName {
    "{COLOR GREEN}All right-what's your name?{COLOR WHITE}$"
}

text gText_Birch_SoItsPlayer {
    "{COLOR GREEN}So it's {PLAYER}{KUN}?{COLOR WHITE}$"
}

text gText_Birch_YourePlayer {
    "{COLOR GREEN}All set… wait.\p"
    "It really is you, isn't it?\p"
    "Eight years since LITTLEROOT…\p"
    "HOENN's not normal right now.\n"
    "We'll talk when you arrive.\p"
    "Your mom said you're in town.\p"
    "Come to the lab, {PLAYER}.\n"
    "I'll be waiting.{COLOR WHITE}\p"
}

text gText_Birch_AreYouReady {
    "{COLOR GREEN}Ready! Your journey begins now,\n"
    "{PLAYER}{KUN}!{COLOR WHITE}\p"
}
