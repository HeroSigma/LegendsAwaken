@ =============================================================================
@ LEGENDS AWAKEN - NEW GAME INTRODUCTION SEQUENCE
@ Creator's Welcome + Professor Birch Introduction with Backstory Hints
@ =============================================================================

gText_Creator_Greeting::
	.string "Greetings, traveler. I am HERO SIGMA-\n"
	.string "the one who shaped this world.\n"
	.string "$"

gText_Creator_Journey::
	.string "This is no ordinary journey.\n"
	.string "Legends stir across time and space…\n"
	.string "awakened by the Rift that tore our\n"
	.string "worlds apart.\n"
	.string "$"

gText_Creator_Truth::
	.string "Here, you will walk among them,\n"
	.string "battle them, and uncover truths\n"
	.string "long buried.\n"
	.string "$"

gText_Creator_Choices::
	.string "But remember… your choices will echo\n"
	.string "across regions.\n"
	.string "Your bonds with POKéMON will shape\n"
	.string "the fate of all creation.\n"
	.string "$"

