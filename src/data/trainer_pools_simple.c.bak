// Exposed pool arrays for external access - use the static arrays directly
// No need for duplicate extern declarations

// Pool mapping for trainer classes
const SimpleTrainerPool *GetSimplePoolForClass(u8 trainerClass)
{
    switch (trainerClass)
    {
        case TRAINER_CLASS_HIKER:
        case TRAINER_CLASS_BLACK_BELT:
            return gFightingPool;
        case TRAINER_CLASS_YOUNGSTER:
            return gBasicPool;
        case TRAINER_CLASS_FISHERMAN:
            return gWaterPool;
        case TRAINER_CLASS_PSYCHIC:
            return gPsychicPool;
        case TRAINER_CLASS_LASS:
            return gNormalPool;
        case TRAINER_CLASS_BUG_CATCHER:
            return gBugPool;
        case TRAINER_CLASS_SWIMMER_M:
        case TRAINER_CLASS_SWIMMER_F:
            return gWaterPool;
        case TRAINER_CLASS_COOLTRAINER:
        case TRAINER_CLASS_COOLTRAINER_2:
            return gBasicPool;
        case TRAINER_CLASS_GENTLEMAN:
            return gNormalPool;
        case TRAINER_CLASS_BEAUTY:
            return gFairyPool;
        case TRAINER_CLASS_LADY:
            return gNormalPool;
        case TRAINER_CLASS_CAMPER:
        case TRAINER_CLASS_PICNICKER:
            return gGrassPool;
        case TRAINER_CLASS_POKEMANIAC:
            return gNormalPool;
        case TRAINER_CLASS_RUIN_MANIAC:
            return gGroundPool;
        case TRAINER_CLASS_GUITARIST:
            return gElectricPool;
        case TRAINER_CLASS_BIRD_KEEPER:
            return gFlyingPool;
        case TRAINER_CLASS_SAILOR:
            return gWaterPool;
        case TRAINER_CLASS_AQUA_ADMIN:
        case TRAINER_CLASS_AQUA_LEADER:
        case TRAINER_CLASS_TEAM_AQUA:
            return gWaterPool;
        case TRAINER_CLASS_MAGMA_ADMIN:
        case TRAINER_CLASS_MAGMA_LEADER:
        case TRAINER_CLASS_TEAM_MAGMA:
            return gFirePool;
        case TRAINER_CLASS_ELITE_FOUR:
            return gDragonPool;
        case TRAINER_CLASS_LEADER:
            return gBasicPool;
        case TRAINER_CLASS_CHAMPION:
            return gDragonPool;
        case TRAINER_CLASS_RIVAL:
            return gBasicPool;
        case TRAINER_CLASS_PKMN_TRAINER_1:
        case TRAINER_CLASS_PKMN_TRAINER_2:
            return gBasicPool;
        default:
            return gBasicPool;
    }
}

u16 GetAceSpeciesForSimplePool(u8 trainerClass)
{
    switch (trainerClass)
    {
        case TRAINER_CLASS_HIKER:
        case TRAINER_CLASS_BLACK_BELT:
            return SPECIES_MACHAMP;
        case TRAINER_CLASS_YOUNGSTER:
            return SPECIES_CHARIZARD;
        case TRAINER_CLASS_FISHERMAN:
            return SPECIES_MAGIKARP;
        case TRAINER_CLASS_PSYCHIC:
            return SPECIES_ALAKAZAM;
        case TRAINER_CLASS_LASS:
            return SPECIES_PIKACHU;
        case TRAINER_CLASS_BUG_CATCHER:
            return SPECIES_SCIZOR;
        case TRAINER_CLASS_SWIMMER_M:
        case TRAINER_CLASS_SWIMMER_F:
            return SPECIES_GYARADOS;
        case TRAINER_CLASS_COOLTRAINER:
        case TRAINER_CLASS_COOLTRAINER_2:
            return SPECIES_DRAGONITE;
        case TRAINER_CLASS_BEAUTY:
            return SPECIES_SYLVEON;
        case TRAINER_CLASS_LADY:
            return SPECIES_BLISSEY;
        case TRAINER_CLASS_CAMPER:
        case TRAINER_CLASS_PICNICKER:
            return SPECIES_VENUSAUR;
        case TRAINER_CLASS_POKEMANIAC:
            return SPECIES_SNORLAX;
        case TRAINER_CLASS_GENTLEMAN:
            return SPECIES_ALAKAZAM;
        case TRAINER_CLASS_RUIN_MANIAC:
            return SPECIES_RHYDON;
        case TRAINER_CLASS_GUITARIST:
            return SPECIES_RAICHU;
        case TRAINER_CLASS_BIRD_KEEPER:
            return SPECIES_STARAPTOR;
        case TRAINER_CLASS_SAILOR:
            return SPECIES_BLASTOISE;
        case TRAINER_CLASS_AQUA_ADMIN:
        case TRAINER_CLASS_AQUA_LEADER:
        case TRAINER_CLASS_TEAM_AQUA:
            return SPECIES_KYOGRE;
        case TRAINER_CLASS_MAGMA_ADMIN:
        case TRAINER_CLASS_MAGMA_LEADER:
        case TRAINER_CLASS_TEAM_MAGMA:
            return SPECIES_GROUDON;
        case TRAINER_CLASS_ELITE_FOUR:
            return SPECIES_DRAGONITE;
        case TRAINER_CLASS_LEADER:
            return SPECIES_METAGROSS;
        case TRAINER_CLASS_CHAMPION:
            return SPECIES_RAYQUAZA;
        case TRAINER_CLASS_RIVAL:
            return SPECIES_CHARIZARD;
        case TRAINER_CLASS_PKMN_TRAINER_1:
        case TRAINER_CLASS_PKMN_TRAINER_2:
            return SPECIES_PIKACHU;
        default:
            return SPECIES_PIKACHU;
    }
}
