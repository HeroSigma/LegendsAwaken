// ─────────────────────────────────────────────────────────────
// HELPER FUNCTIONS
// ─────────────────────────────────────────────────────────────
u16 GetRandomMegaStone(u8 trainerClass)
{
    if (trainerClass >= TRAINER_CLASS_COUNT)
        return ITEM_NONE;
    
    const MechanicItemLine *pool = gMegaStonePools[trainerClass];
    u32 totalWeight = 0;
    
    // Calculate total weight
    for (int i = 0; i < 8 && pool[i].item != ITEM_NONE; i++)
        totalWeight += pool[i].weight;
    
    if (totalWeight == 0)
        return ITEM_NONE;
    
    // Random selection
    u32 rand = Random() % totalWeight;
    u32 currentWeight = 0;
    
    for (int i = 0; i < 8 && pool[i].item != ITEM_NONE; i++) {
        currentWeight += pool[i].weight;
        if (rand < currentWeight)
            return pool[i].item;
    }
    
    return ITEM_NONE;
}

u16 GetRandomZCrystal(u8 trainerClass)
{
    if (trainerClass >= TRAINER_CLASS_COUNT)
        return ITEM_NONE;
    
    const MechanicItemLine *pool = gZCrystalPools[trainerClass];
    u32 totalWeight = 0;
    
    for (int i = 0; i < 8 && pool[i].item != ITEM_NONE; i++)
        totalWeight += pool[i].weight;
    
    if (totalWeight == 0)
        return ITEM_NONE;
    
    u32 rand = Random() % totalWeight;
    u32 currentWeight = 0;
    
    for (int i = 0; i < 8 && pool[i].item != ITEM_NONE; i++) {
        currentWeight += pool[i].weight;
        if (rand < currentWeight)
            return pool[i].item;
    }
    
    return ITEM_NONE;
}

u8 GetRandomTeraType(u8 trainerClass)
{
    if (trainerClass >= TRAINER_CLASS_COUNT)
        return TYPE_NONE;
    
    const TeraTypeLine *pool = gTeraTypePools[trainerClass];
    u32 totalWeight = 0;
    
    for (int i = 0; i < 8 && pool[i].teraType != TYPE_NONE; i++)
        totalWeight += pool[i].weight;
    
    if (totalWeight == 0)
        return TYPE_NONE;
    
    u32 rand = Random() % totalWeight;
    u32 currentWeight = 0;
    
    for (int i = 0; i < 8 && pool[i].teraType != TYPE_NONE; i++) {
        currentWeight += pool[i].weight;
        if (rand < currentWeight)
            return pool[i].teraType;
    }
    
    return TYPE_NONE;
}

bool8 CanDynamaxThisTrainer(u8 trainerClass)
{
    // Most trainers can Dynamax, but some are excluded
    switch (trainerClass) {
        case TRAINER_CLASS_HIKER:
        case TRAINER_CLASS_COOLTRAINER:
        case TRAINER_CLASS_BLACK_BELT:
        case TRAINER_CLASS_PSYCHIC:
        case TRAINER_CLASS_BEAUTY:
        case TRAINER_CLASS_LADY:
        case TRAINER_CLASS_COLLECTOR:
        case TRAINER_CLASS_AROMA_LADY:
            return TRUE;
        case TRAINER_CLASS_TEAM_AQUA:
        case TRAINER_CLASS_TEAM_MAGMA:
            return TRUE;
        default:
            return TRUE; // Default to allowing Dynamax
    }
}
